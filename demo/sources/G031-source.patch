+    data.scope !== scope ||
+    !hash(scope) ||
+    !identifier(data.task_id, 16) ||
+    !identifier(data.job_id) ||
+    !identifier(data.candidate_id) ||
+    !hash(data.source_hash) ||
+    !count(data.call_seq) ||
+    data.call_seq === 0
+  )
