+    schemaVersion: 1,
+    scope,
+    run_id: data.run_id,
+    task_id: data.task_id,
+    job_id: data.job_id,
+    source_hash: data.source_hash,
+    status,
+    ...(validCounts ? { passed: data.passed as number, total: data.total as number } : {}),
